[Unit]
Description=NRO Shield v2 - AI Powered Integrated Firewall
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nroshield/v2/backend
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
EnvironmentFile=/opt/nroshield/v2/backend/.env

[Install]
WantedBy=multi-user.target
