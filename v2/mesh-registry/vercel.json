{
    "version": 2,
    "name": "samp-shield-mesh-registry",
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/ping",
            "dest": "/api/ping.js"
        },
        {
            "src": "/api/peers",
            "dest": "/api/peers.js"
        }
    ]
}